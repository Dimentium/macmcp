#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source_root="$(cd "$script_dir/.." && pwd)"
staging_root=""

usage() {
  cat <<'EOF'
Usage: macmcp <command> [options]

Commands:
  setup       Install MacMCP and configure a first local runtime.
  upgrade     Install the current version and retain existing configuration.
  uninstall   Remove the local MacMCP runtime and configuration.
  diagnose    Print a sanitized local runtime report.
  help        Show this help.

Options after setup or upgrade are passed to the MacMCP installer.
EOF
}

cleanup() {
  if [[ -n "$staging_root" ]]; then
    /bin/rm -rf "$staging_root"
  fi
}

run_installer() {
  staging_root="$(mktemp -d "${TMPDIR:-/tmp}/macmcp-source.XXXXXX")"
  /usr/bin/ditto "$source_root" "$staging_root"
  "$staging_root/scripts/install-local.sh" "$@"
}

trap cleanup EXIT

command_name="${1:-setup}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command_name" in
  setup)
    run_installer "$@"
    ;;
  upgrade)
    run_installer --reuse-existing-configuration "$@"
    ;;
  uninstall)
    exec "$source_root/scripts/uninstall-local.sh" "$@"
    ;;
  diagnose)
    runtime_cli="${MACMCP_RUNTIME_CLI:-$HOME/.local/bin/mac-agent-bridge}"
    [[ -x "$runtime_cli" ]] || {
      echo "MacMCP runtime is not installed at $runtime_cli" >&2
      exit 1
    }
    exec "$runtime_cli" --diagnose-json
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac
