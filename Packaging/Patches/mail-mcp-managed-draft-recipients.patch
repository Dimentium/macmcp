+
+func normalizeManagedDraftMessageID(value string) (string, error) {
+	value = strings.TrimSpace(value)
+	if value == "" || len(value) > 998 {
+		return "", fmt.Errorf("invalid Message-ID")
+	}
+	startsBracketed := strings.HasPrefix(value, "<")
+	endsBracketed := strings.HasSuffix(value, ">")
+	if startsBracketed != endsBracketed {
+		return "", fmt.Errorf("invalid Message-ID")
+	}
+	if startsBracketed {
+		value = value[1 : len(value)-1]
+	}
+	if value == "" || !strings.Contains(value, "@") || strings.ContainsAny(value, "<>\x00\r\n\t ") {
+		return "", fmt.Errorf("invalid Message-ID")
+	}
+	return "<" + value + ">", nil
+}
+
+func normalizeManagedDraftReferences(references []string) ([]string, error) {
+	if len(references) > 100 {
+		return nil, fmt.Errorf("References chain exceeds the 100-message limit")
+	}
+	normalized := make([]string, 0, len(references))
+	seen := make(map[string]struct{}, len(references))
+	totalBytes := 0
+	for _, reference := range references {
+		id, err := normalizeManagedDraftMessageID(reference)
+		if err != nil {
+			return nil, err
+		}
+		if _, exists := seen[id]; exists {
+			continue
+		}
+		seen[id] = struct{}{}
+		totalBytes += len(id) + 1
+		if totalBytes > 8192 {
+			return nil, fmt.Errorf("References chain exceeds the 8192-byte limit")
+		}
+		normalized = append(normalized, id)
+	}
+	return normalized, nil
+}
+
+func managedDraftHeaderValues(header stdmail.Header, field string) []string {
+	for name, values := range header {
+		if strings.EqualFold(name, field) {
+			return values
+		}
+	}
+	return nil
+}
