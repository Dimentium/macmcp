@@ -307 +378,58 @@ func managedDraftReadInfo(raw, key []byte) *managedDraftReadOutput {
-func hasRecipientHeaders(header stdmail.Header) bool {
+func managedDraftRecipientsFromRaw(raw []byte) (managedDraftRecipients, error) {
+	message, err := stdmail.ReadMessage(bytes.NewReader(raw))
+	if err != nil {
+		return managedDraftRecipients{}, err
+	}
+	return managedDraftRecipientsFromHeader(message.Header)
+}
+
+func managedDraftRecipientsFromHeader(header stdmail.Header) (managedDraftRecipients, error) {
+	parse := func(field string) ([]string, error) {
+		var addresses []string
+		for _, value := range managedDraftHeaderValues(header, field) {
+			if strings.TrimSpace(value) == "" {
+				return nil, fmt.Errorf("empty %s header", field)
+			}
+			parsed, err := stdmail.ParseAddressList(value)
+			if err != nil {
+				return nil, fmt.Errorf("invalid %s header", field)
+			}
+			for _, address := range parsed {
+				addresses = append(addresses, address.String())
+			}
+		}
+		if len(addresses) > 0 {
+			if err := send.ValidateRecipients(addresses, strings.ToLower(field)); err != nil {
+				return nil, err
+			}
+		}
+		return addresses, nil
+	}
+	to, err := parse("To")
+	if err != nil {
+		return managedDraftRecipients{}, err
+	}
+	cc, err := parse("Cc")
+	if err != nil {
+		return managedDraftRecipients{}, err
+	}
+	bcc, err := parse("Bcc")
+	if err != nil {
+		return managedDraftRecipients{}, err
+	}
+	if len(to)+len(cc)+len(bcc) > send.MaxRecipients {
+		return managedDraftRecipients{}, fmt.Errorf("managed draft recipient count exceeds the limit")
+	}
+	return managedDraftRecipients{To: to, Cc: cc, Bcc: bcc}, nil
+}
+
+func managedDraftHeaderValues(header stdmail.Header, field string) []string {
+	for name, values := range header {
+		if strings.EqualFold(name, field) {
+			return values
+		}
+	}
+	return nil
+}
