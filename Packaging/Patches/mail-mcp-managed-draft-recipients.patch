+func TestManagedReplyDraftPreservesThreadHeadersOnUpdate(t *testing.T) {
+	acc := &config.Account{
+		ID: "personal", FromAddress: "me@example.com",
+		SMTP: config.Endpoint{Username: "me@example.com"},
+	}
+	original := &mailmime.Message{
+		From:       "Sender <sender@example.com>",
+		To:         []string{"me@example.com"},
+		ReplyTo:    []string{"replies@example.com"},
+		Subject:    "Re: Quarterly report",
+		MessageID:  "<current@example.com>",
+		References: []string{"<root@example.com>"},
+		BodyText:   "Original body",
+	}
+
+	composition, metadata, err := buildManagedReplyDraft(acc, original, managedReplyDraftInput{
+		To:       []string{"override@example.com"},
+		BodyText: "My reply",
+	})
+	if err != nil {
+		t.Fatalf("buildManagedReplyDraft: %v", err)
+	}
+	if composition.Subject != "Re: Quarterly report" {
+		t.Errorf("subject = %q, want one Re: prefix", composition.Subject)
+	}
+	if len(metadata.To) != 1 || metadata.To[0] != "override@example.com" {
+		t.Errorf("To = %v, want explicit override", metadata.To)
+	}
+	if metadata.InReplyTo != "<current@example.com>" {
+		t.Errorf("In-Reply-To = %q", metadata.InReplyTo)
+	}
+	if len(metadata.References) != 2 || metadata.References[0] != "<root@example.com>" || metadata.References[1] != "<current@example.com>" {
+		t.Errorf("References = %v, want root then original", metadata.References)
+	}
+
+	raw, err := buildManagedDraft(acc, composition.Subject, composition.BodyText, composition.BodyHTML, "marker", metadata)
+	if err != nil {
+		t.Fatalf("buildManagedDraft: %v", err)
+	}
+	stored, err := managedDraftRecipientsFromRaw(raw)
+	if err != nil {
+		t.Fatalf("managedDraftRecipientsFromRaw: %v", err)
+	}
+	updated, err := buildManagedDraft(acc, "Updated subject", "Updated body", "", "marker", stored)
+	if err != nil {
+		t.Fatalf("updated buildManagedDraft: %v", err)
+	}
+	updatedMetadata, err := managedDraftRecipientsFromRaw(updated)
+	if err != nil {
+		t.Fatalf("updated managedDraftRecipientsFromRaw: %v", err)
+	}
+	if updatedMetadata.InReplyTo != metadata.InReplyTo || strings.Join(updatedMetadata.References, " ") != strings.Join(metadata.References, " ") {
+		t.Errorf("thread metadata changed on update: In-Reply-To=%q References=%v", updatedMetadata.InReplyTo, updatedMetadata.References)
+	}
+	if len(updatedMetadata.To) != 1 || !containsAddress(updatedMetadata.To, "override@example.com") {
+		t.Errorf("updated To = %v, want recipient preserved", updatedMetadata.To)
+	}
+}
+
+func TestManagedReplyDraftRequiresThreadableMessageIDAndValidReferences(t *testing.T) {
+	acc := &config.Account{ID: "personal", FromAddress: "me@example.com"}
+	base := &mailmime.Message{
+		From: "sender@example.com", Subject: "Topic", MessageID: "<current@example.com>",
+		BodyText: "Original body",
+	}
+	input := managedReplyDraftInput{BodyText: "Reply"}
+
+	withoutMessageID := *base
+	withoutMessageID.MessageID = ""
+	if _, _, err := buildManagedReplyDraft(acc, &withoutMessageID, input); err == nil {
+		t.Fatal("reply draft without Message-ID was accepted")
+	}
+
+	withBadReferences := *base
+	withBadReferences.References = []string{"<bad reference>"}
+	if _, _, err := buildManagedReplyDraft(acc, &withBadReferences, input); err == nil {
+		t.Fatal("reply draft with invalid References was accepted")
+	}
+}
