+func withManagedDraftBccHeader(raw []byte, recipients []string) ([]byte, error) {
+	if len(recipients) == 0 {
+		return raw, nil
+	}
+
+	lineEnding := "\r\n"
+	separator := []byte("\r\n\r\n")
+	boundary := bytes.Index(raw, separator)
+	if boundary < 0 {
+		lineEnding = "\n"
+		separator = []byte("\n\n")
+		boundary = bytes.Index(raw, separator)
+	}
+	if boundary < 0 {
+		return nil, fmt.Errorf("managed draft has no header/body separator")
+	}
+
+	var header strings.Builder
+	header.WriteString("Bcc: ")
+	lineLength := len("Bcc: ")
+	for index, rawAddress := range recipients {
+		address, err := stdmail.ParseAddress(rawAddress)
+		if err != nil {
+			return nil, fmt.Errorf("invalid Bcc address")
+		}
+		formatted := address.String()
+		if index > 0 {
+			if lineLength+2+len(formatted) > 78 {
+				header.WriteString("," + lineEnding + "\t")
+				lineLength = 1
+			} else {
+				header.WriteString(", ")
+				lineLength += 2
+			}
+		}
+		if lineLength+len(formatted) > 998 {
+			return nil, fmt.Errorf("Bcc address exceeds the header line limit")
+		}
+		header.WriteString(formatted)
+		lineLength += len(formatted)
+	}
+	line := []byte(lineEnding + header.String())
+	result := make([]byte, 0, len(raw)+len(line))
+	result = append(result, raw[:boundary]...)
+	result = append(result, line...)
+	result = append(result, raw[boundary:]...)
+	return result, nil
