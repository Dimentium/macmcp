+struct EventSearchWindow: Equatable {
+    let start: Date
+    let end: Date
+}
+
+enum EventSearchRangePlanner {
+    static let maximumWindowYears = 4
+
+    static func windows(
+        from startDate: Date,
+        to endDate: Date,
+        calendar: Calendar = .current
+    ) -> [EventSearchWindow] {
+        guard startDate < endDate else { return [] }
+
+        var windows: [EventSearchWindow] = []
+        var windowStart = startDate
+        while windowStart < endDate {
+            let proposedEnd = calendar.date(
+                byAdding: .year,
+                value: maximumWindowYears,
+                to: windowStart
+            ) ?? endDate
+            let windowEnd = min(proposedEnd, endDate)
+            guard windowEnd > windowStart else { break }
+            windows.append(EventSearchWindow(start: windowStart, end: windowEnd))
+            windowStart = windowEnd
+        }
+        return windows
+    }
+}
