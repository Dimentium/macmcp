diff --git a/Tests/CheICalMCPTests/EventSearchRangePlannerTests.swift b/Tests/CheICalMCPTests/EventSearchRangePlannerTests.swift
new file mode 100644
index 0000000..5c0e9a1
--- /dev/null
+++ b/Tests/CheICalMCPTests/EventSearchRangePlannerTests.swift
@@ -0,0 +1,38 @@
+import XCTest
+@testable import CheICalMCP
+
+final class EventSearchRangePlannerTests: XCTestCase {
+    func testSplitsLongSearchIntoAdjacentFourYearWindows() throws {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = try XCTUnwrap(TimeZone(secondsFromGMT: 0))
+        let formatter = ISO8601DateFormatter()
+        let start = try XCTUnwrap(formatter.date(from: "2010-01-01T00:00:00Z"))
+        let end = try XCTUnwrap(formatter.date(from: "2026-11-06T00:00:00Z"))
+
+        let windows = EventSearchRangePlanner.windows(from: start, to: end, calendar: calendar)
+
+        XCTAssertEqual(windows.count, 5)
+        XCTAssertEqual(windows.first?.start, start)
+        XCTAssertEqual(windows.last?.end, end)
+        for window in windows {
+            let maximumEnd = try XCTUnwrap(
+                calendar.date(
+                    byAdding: .year,
+                    value: EventSearchRangePlanner.maximumWindowYears,
+                    to: window.start
+                )
+            )
+            XCTAssertLessThanOrEqual(window.end, maximumEnd)
+        }
+        for (left, right) in zip(windows, windows.dropFirst()) {
+            XCTAssertEqual(left.end, right.start)
+        }
+    }
+
+    func testEmptyOrReversedRangeProducesNoWindows() throws {
+        let date = try XCTUnwrap(ISO8601DateFormatter().date(from: "2026-01-01T00:00:00Z"))
+
+        XCTAssertTrue(EventSearchRangePlanner.windows(from: date, to: date).isEmpty)
+        XCTAssertTrue(EventSearchRangePlanner.windows(from: date, to: .distantPast).isEmpty)
+    }
+}
